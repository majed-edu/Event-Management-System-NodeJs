
<%- include("partials/header") %>

<section class="auth-layout">
  <div class="auth-panel">
    <span class="eyebrow">Welcome back</span>
    <h1>Log in to Mawid</h1>
    <p class="muted">Continue managing your events and registrations.</p>

    <% if (error) { %>
      <div class="alert"><%= error %></div>
    <% } %>

    <form class="form-stack" action="/login" method="POST">
      <div class="field">
        <label for="login-email">Email</label>
        <input id="login-email" type="email" name="email" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="login-password">Password</label>
        <input id="login-password" type="password" name="password" autocomplete="current-password" required>
      </div>
      <button class="button button-full" type="submit">Log in</button>
    </form>
    <p class="form-switch">New to Mawid? <a href="/signup">Create an account</a></p>
  </div>
</section>

<%- include("partials/footer") %>
