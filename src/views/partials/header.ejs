<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#111827">
  <title><%= typeof title !== "undefined" ? title : "Mawid" %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <header class="site-header">
    <div class="nav-wrap">
      <a class="brand" href="/" aria-label="Mawid home">
        <span class="brand-mark">M</span>
        <span>Mawid</span>
      </a>
      <nav class="nav-actions" aria-label="Main navigation">
        <% if (user) { %>
          <a class="nav-link" href="/dashboard">My events</a>
          <form action="/logout" method="POST">
            <button class="nav-button" type="submit">Log out</button>
          </form>
        <% } else { %>
          <a class="nav-link" href="/login">Log in</a>
          <a class="button button-small" href="/signup">Create account</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="page-shell">