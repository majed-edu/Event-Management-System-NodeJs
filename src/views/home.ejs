<%- include("partials/header") %>

<% if (user) { %>
  <section class="hero">
    <div>
      <span class="eyebrow">Organizer workspace</span>
      <h1>Welcome back, <%= user.name %></h1>
      <p>Create another event or manage registrations and attendee capacity.</p>
      <div class="hero-actions">
        <a class="button" href="/events/new">Create event</a>
        <a class="button button-secondary" href="/dashboard">View my events</a>
      </div>
    </div>
  </section>
<% } else { %>
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">Events made simple</span>
      <h1>Bring people together, without the busywork.</h1>
      <p>Create a beautiful event page, share one public link, and keep every seat organized.</p>
      <div class="hero-actions">
        <a class="button" href="/signup">Start for free</a>
        <a class="button button-secondary" href="/login">Log in</a>
      </div>
    </div>
    <div class="hero-card" aria-hidden="true">
      <div class="hero-card-top">
        <span class="status-dot"></span>
        <span>Live registration</span>
      </div>
      <h2>Community Meetup</h2>
      <div class="metric-row">
        <div><strong>42</strong><span>registered</span></div>
        <div><strong>50</strong><span>capacity</span></div>
      </div>
      <div class="capacity-track"><span></span></div>
    </div>
  </section>
<% } %>

<%- include("partials/footer") %>