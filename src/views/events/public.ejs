<%- include("../partials/header") %>

<h1><%= event.title %></h1>
<p><%= event.location || "Location to be announced" %></p>
<p>Starts: <%= event.startsAt.toLocaleString() %></p>
<p><%= registeredCount %>/<%= event.capacity %> seats registered</p>

<% if (registered) { %>
  <p>Registration successful.</p>
<% } %>

<% if (error) { %>
  <p><%= error %></p>
<% } %>

<% if (registeredCount < event.capacity) { %>
  <form action="/events/<%= event.slug %>/register" method="POST">
    <div>
      <label>Name:
        <input type="text" name="name" maxlength="100" required>
      </label>
    </div>
    <div>
      <label>Email:
        <input type="email" name="email" maxlength="255" required>
      </label>
    </div>
    <button type="submit">Register</button>
  </form>
<% } else { %>
  <p>Sorry, this event is full.</p>
<% } %>

<%- include("../partials/footer") %>
